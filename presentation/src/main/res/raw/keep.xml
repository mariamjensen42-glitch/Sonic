<?xml version="1.0" encoding="utf-8"?>
<!--
  保留全部 Flamingo 图标。

  这套 ic_flamingo_* 是 Flamingo 1.0.0 里**全部**应用自有图标（65 个）—— 播放页 / 歌词页 /
  资料库 / tab 栏 / 迷你条 / 占位图 / 应用图标都在里面，目前 UI 只用到其中二十来个。
  release 开了 shrinkResources，没有这条规则的话，剩下那些会被当作无用资源裁掉 ——
  下次想用某一张时只能重新从 APK 里刨一遍。六十来个 vector，每个一两 KB，留着更省事。
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_flamingo_*" />
